---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getGpus } from '../lib/db';
import { SITE_URL } from '../lib/site';

const gpus = await getGpus(Astro.locals);
const brands = [...new Set(gpus.map(g => g.brand))].sort();

const description = `Complete database of ${gpus.length} desktop and laptop graphics cards, ranked by gaming performance with VRAM, TDP, MSRP, DLSS/FSR support and tier. Free to browse.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "GPU Database",
  "description": description,
  "url": `${SITE_URL}/gpus`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": gpus.length,
    "itemListElement": gpus.slice(0, 40).map((g, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `${SITE_URL}/gpu/${g.slug}`,
      "name": g.name
    }))
  }
};
---
<BaseLayout
  title={`GPU Database — ${gpus.length} Graphics Cards Ranked | PCGameFit`}
  description={description}
  keywords="gpu database, graphics card list, gpu comparison, gpu specs, vram, gpu benchmark ranking"
  jsonLd={schema}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'GPU Database' }]} />

    <header class="page-head">
      <h1>GPU Database</h1>
      <p class="lede">
        Every graphics card we track, ranked by gaming performance score. Click any card
        for its full spec sheet, the games it handles, and head-to-head comparisons.
      </p>
    </header>

    <div class="controls">
      <input type="search" id="gpu-filter" placeholder="Filter by name…" aria-label="Filter graphics cards">
      <div class="brand-chips" role="group" aria-label="Filter by brand">
        <button class="chip active" data-brand="">All</button>
        {brands.map(b => <button class="chip" data-brand={b}>{b}</button>)}
      </div>
    </div>

    <div class="table-scroll">
      <table class="data-table" id="gpu-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Graphics card</th>
            <th>Tier</th>
            <th>Score</th>
            <th>VRAM</th>
            <th>TDP</th>
            <th>MSRP</th>
            <th>Year</th>
            <th>Upscaling</th>
          </tr>
        </thead>
        <tbody>
          {gpus.map((g, i) => (
            <tr data-brand={g.brand} data-name={g.name.toLowerCase()}>
              <td class="rank">{i + 1}</td>
              <td><a href={`/gpu/${g.slug}`}>{g.name}</a></td>
              <td><span class={`pill t-${g.tier}`}>{g.tier}</span></td>
              <td><b>{g.score}</b></td>
              <td>{g.vram_gb} GB</td>
              <td>{g.tdp_watts} W</td>
              <td>{g.msrp_usd ? `$${g.msrp_usd}` : '—'}</td>
              <td>{g.release_year}</td>
              <td class="feat">
                {g.supports_dlss ? <span class="tag">DLSS</span> : null}
                {g.supports_fsr ? <span class="tag">FSR</span> : null}
                {g.supports_xess ? <span class="tag">XeSS</span> : null}
                {g.supports_ray_tracing ? <span class="tag rt">RT</span> : null}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <section class="related">
      <h2>Related</h2>
      <ul>
        <li><a href="/gpu-tier-list">GPU Tier List 2026</a></li>
        <li><a href="/compare-gpu">Compare two GPUs</a></li>
        <li><a href="/cpus">CPU Database</a></li>
        <li><a href="/bottleneck">Bottleneck Calculator</a></li>
        <li><a href="/psu-calculator">PSU Calculator</a></li>
        <li><a href="/upgrade-advisor">Upgrade Advisor</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .controls { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-bottom: 22px; }
  .controls input {
    flex: 1 1 240px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: 10px 14px;
    color: var(--text);
    font: inherit;
    outline: none;
  }
  .controls input:focus { border-color: var(--accent); }
  .brand-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip {
    background: transparent; border: 1px solid var(--line-strong); color: var(--muted);
    padding: 6px 14px; border-radius: 999px; font: inherit; font-size: 13px; cursor: pointer;
    transition: all .2s var(--ease);
  }
  .chip:hover { color: var(--text); }
  .chip.active { background: var(--accent); border-color: var(--accent); color: #000; font-weight: 600; }
  .rank { color: var(--faint); font-variant-numeric: tabular-nums; }
  .feat { white-space: nowrap; }
  .tag {
    display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .04em;
    padding: 2px 6px; border-radius: 4px; margin-right: 4px;
    background: rgba(182,255,0,.12); color: var(--accent);
  }
  .tag.rt { background: rgba(120,180,255,.14); color: #8ab8ff; }
</style>

<script>
  const rows = document.querySelectorAll<HTMLTableRowElement>('#gpu-table tbody tr');
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const input = document.getElementById('gpu-filter') as HTMLInputElement;
  let brand = '', term = '';

  function apply() {
    rows.forEach(r => {
      const ok = (!brand || r.dataset.brand === brand)
              && (!term || (r.dataset.name || '').includes(term));
      r.hidden = !ok;
    });
  }
  chips.forEach(c => c.addEventListener('click', () => {
    chips.forEach(x => x.classList.remove('active'));
    c.classList.add('active');
    brand = c.dataset.brand || '';
    apply();
  }));
  input?.addEventListener('input', () => { term = input.value.trim().toLowerCase(); apply(); });
</script>
