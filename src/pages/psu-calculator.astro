---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<BaseLayout
  title="PSU Calculator — What Wattage PSU Do I Need? | PCGameFit"
  description="Size your power supply correctly. Pick your GPU, CPU and drives to get a recommended wattage with proper transient and efficiency headroom."
  keywords="psu calculator, power supply wattage, what psu do i need, pc power consumption"
>
  <Breadcrumbs items={[{ name: 'Tools', href: '/tools' }, { name: 'PSU Calculator' }]} />
  <h1>PSU Calculator — Find Your Power Supply Wattage</h1>

  <div class="calculator-container">
    <form id="psu-form" class="psu-form">
      <div class="form-group">
        <label>GPU (Graphics Card)</label>
        <select id="gpu-tdp">
          <option value="0">None</option>
          <option value="450">RTX 4090 (450W)</option>
          <option value="320">RTX 4080 (320W)</option>
          <option value="200">RTX 4070 (200W)</option>
        </select>
      </div>

      <div class="form-group">
        <label>CPU (Processor)</label>
        <select id="cpu-tdp">
          <option value="0">None</option>
          <option value="253">Core i9-14900K (253W)</option>
          <option value="120">Ryzen 7 7800X3D (120W)</option>
          <option value="65">Ryzen 5 7600 (65W)</option>
        </select>
      </div>

      <div class="form-group">
        <label>RAM Sticks (5W each)</label>
        <input type="number" id="ram" min="0" max="8" value="2">
      </div>

      <div class="form-group">
        <label>Storage Drives (HDDs 7W, SSDs 3W)</label>
        <div style="display:flex;gap:1rem;">
          <input type="number" id="hdd" min="0" max="10" value="0" placeholder="HDDs">
          <input type="number" id="ssd" min="0" max="10" value="1" placeholder="SSDs">
        </div>
      </div>

      <div class="form-group">
        <label>Fans (3W each)</label>
        <input type="number" id="fans" min="0" max="20" value="4">
      </div>

      <div class="form-group">
        <label><input type="checkbox" id="rgb"> Add RGB Lighting (+15W)</label>
      </div>
      <div class="form-group">
        <label><input type="checkbox" id="oc"> Overclocking (+15%)</label>
      </div>

      <button type="submit" class="btn">Calculate PSU Wattage</button>
    </form>

    <div id="psu-results" class="psu-results" style="display: none;">
      <h2>Results</h2>
      <p>Total System TDP: <strong id="total-tdp"></strong></p>
      <h3>Recommended PSU: <span id="rec-psu" class="highlight"></span></h3>
      <p>Efficiency Tier: <strong id="eff-tier"></strong></p>
      
      <h4>Recommended Products</h4>
      <ul id="product-recs"></ul>
    </div>
  </div>
</BaseLayout>

<script>
  document.getElementById('psu-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const gpu = parseInt((document.getElementById('gpu-tdp') as HTMLSelectElement).value) || 0;
    const cpu = parseInt((document.getElementById('cpu-tdp') as HTMLSelectElement).value) || 0;
    const ram = parseInt((document.getElementById('ram') as HTMLInputElement).value) || 0;
    const hdd = parseInt((document.getElementById('hdd') as HTMLInputElement).value) || 0;
    const ssd = parseInt((document.getElementById('ssd') as HTMLInputElement).value) || 0;
    const fans = parseInt((document.getElementById('fans') as HTMLInputElement).value) || 0;
    const rgb = (document.getElementById('rgb') as HTMLInputElement).checked ? 15 : 0;
    const oc = (document.getElementById('oc') as HTMLInputElement).checked;

    let total = gpu + cpu + (ram * 5) + (hdd * 7) + (ssd * 3) + (fans * 3) + rgb;
    if (oc) total *= 1.15;
    total = Math.ceil(total);

    let rec = total * 1.25;
    const standardSizes = [550, 650, 750, 850, 1000, 1200, 1600];
    let finalPsu = standardSizes.find(s => s >= rec) || 1600;

    const effTier = finalPsu >= 850 ? '80+ Gold or Platinum' : '80+ Bronze or Gold';

    document.getElementById('psu-results')!.style.display = 'block';
    document.getElementById('total-tdp')!.innerText = `${total}W`;
    document.getElementById('rec-psu')!.innerText = `${finalPsu}W`;
    document.getElementById('eff-tier')!.innerText = effTier;

    document.getElementById('product-recs')!.innerHTML = `
      <li><a href="#" target="_blank">Corsair RM${finalPsu}x (Amazon)</a></li>
      <li><a href="#" target="_blank">EVGA SuperNOVA ${finalPsu} G6 (Amazon)</a></li>
      <li><a href="#" target="_blank">SeaSonic Focus GX-${finalPsu} (Amazon)</a></li>
    `;
  });
</script>

<style>
  .calculator-container { display: flex; gap: 2rem; flex-wrap: wrap; }
  .psu-form { flex: 1; min-width: 300px; background: var(--surface, #111420); padding: 2rem; border-radius: 8px; }
  .psu-results { flex: 1; min-width: 300px; background: #1a1a24; padding: 2rem; border-radius: 8px; }
  .form-group { margin-bottom: 1.5rem; }
  .form-group label { display: block; margin-bottom: 0.5rem; font-weight: bold; }
  .form-group select, .form-group input[type="number"] { width: 100%; padding: 0.8rem; background: #000; border: 1px solid #444; color: #fff; border-radius: 4px; }
  .btn { width: 100%; padding: 1rem; background: var(--accent, #B6FF00); color: #000; font-weight: bold; border: none; border-radius: 4px; cursor: pointer; }
  .highlight { color: var(--accent, #B6FF00); font-size: 2rem; }
  ul { padding-left: 1rem; }
  li a { color: #fff; text-decoration: underline; }
</style>
