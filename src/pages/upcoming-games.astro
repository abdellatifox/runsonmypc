---
/**
 * Evergreen entry point. One canonical page per year does the ranking, so this
 * sends visitors (and any link that ages) to the year currently being covered
 * instead of becoming a second, competing copy of it.
 */
export const prerender = false;
import { SEO_YEAR } from '../lib/year';
return Astro.redirect(`/upcoming-games-${SEO_YEAR}`, 301);
---
