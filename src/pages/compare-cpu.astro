---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCpus } from '../lib/db';
import Icon from '../components/Icon.astro';
import { SITE_URL } from '../lib/site';

const cpus = await getCpus(Astro.locals);

const aSlug = Astro.url.searchParams.get('a');
const bSlug = Astro.url.searchParams.get('b');
const a = cpus.find(c => c.slug === aSlug) ?? null;
const b = cpus.find(c => c.slug === bSlug) ?? null;
const paired = Boolean(a && b);

const diff = paired ? a!.score - b!.score : 0;
const pct = paired ? Math.round((Math.abs(diff) / Math.min(a!.score, b!.score)) * 100) : 0;
const winner = paired ? (diff > 0 ? a! : diff < 0 ? b! : null) : null;

const title = paired
  ? `${a!.name} vs ${b!.name} — Which CPU Is Better for Gaming? | PCGameFit`
  : 'CPU Comparison Tool — Compare Processors | PCGameFit';

const description = paired
  ? `${a!.name} vs ${b!.name}: ${winner ? `the ${winner.name} is about ${pct}% faster for gaming` : 'both chips score identically'}. Cores, threads, clocks, TDP and tier compared side by side.`
  : 'Compare any two gaming processors head to head — performance score, cores, threads, clock speeds, power draw and tier. Free and instant.';

const suggested: Array<[typeof cpus[0], typeof cpus[0]]> = [];
for (let i = 0; i < Math.min(cpus.length - 1, 12); i++) suggested.push([cpus[i], cpus[i + 1]]);

const schema: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "CPU Comparison Tool",
    "url": `${SITE_URL}/compare-cpu`,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any (web browser)",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
];
if (paired && winner) {
  const loser = winner.slug === a!.slug ? b! : a!;
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{
      "@type": "Question",
      "name": `Is the ${a!.name} better than the ${b!.name} for gaming?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The ${winner.name} is the stronger gaming processor, scoring ${winner.score}/100 against ${loser.score}/100 — around ${pct}% more performance. The ${a!.name} has ${a!.cores} cores and ${a!.threads} threads boosting to ${a!.boost_ghz} GHz; the ${b!.name} has ${b!.cores} cores and ${b!.threads} threads boosting to ${b!.boost_ghz} GHz.`
      }
    }]
  });
}
---
<BaseLayout title={title} description={description} jsonLd={schema}
  canonical={paired ? `${SITE_URL}/compare-cpu?a=${a!.slug}&b=${b!.slug}` : `${SITE_URL}/compare-cpu`}
  keywords={paired ? `${a!.name} vs ${b!.name}, cpu comparison, gaming cpu` : 'cpu comparison, compare processors, intel vs amd gaming'}>
  <div class="wrap">
    <Breadcrumbs items={paired
      ? [{ name: 'CPU Database', href: '/cpus' }, { name: 'Compare', href: '/compare-cpu' }, { name: `${a!.name} vs ${b!.name}` }]
      : [{ name: 'Tools', href: '/tools' }, { name: 'Compare CPUs' }]} />

    <header class="page-head">
      <h1>{paired ? `${a!.name} vs ${b!.name}` : 'Compare Gaming Processors'}</h1>
      <p class="lede">
        {paired
          ? (winner
              ? `The ${winner.name} is the faster chip for gaming by roughly ${pct}%. Here is the full spec-by-spec breakdown.`
              : 'These two processors score identically for gaming. Core count, power draw and platform cost decide it.')
          : 'Pick any two processors to compare gaming performance, cores, threads, clock speeds and power draw side by side.'}
      </p>
    </header>

    <form class="picker" method="get" action="/compare-cpu">
      <label>
        <span>First processor</span>
        <select name="a">
          <option value="">Select a CPU…</option>
          {cpus.map(c => <option value={c.slug} selected={c.slug === aSlug}>{c.name}</option>)}
        </select>
      </label>
      <span class="vs" aria-hidden="true">VS</span>
      <label>
        <span>Second processor</span>
        <select name="b">
          <option value="">Select a CPU…</option>
          {cpus.map(c => <option value={c.slug} selected={c.slug === bSlug}>{c.name}</option>)}
        </select>
      </label>
      <button type="submit" class="btn btn-primary">Compare</button>
    </form>

    {paired && (
      <>
        <div class="verdict-banner">
          {winner
            ? <><Icon name="trophy-fill" /> <b>{winner.name}</b> wins — about <b>{pct}% faster</b> for gaming</>
            : <><Icon name="dash-circle" /> Dead heat — both processors score {a!.score}/100</>}
        </div>

        <div class="table-scroll">
          <table class="data-table cmp">
            <thead>
              <tr>
                <th>Specification</th>
                <th><a href={`/cpu/${a!.slug}`}>{a!.name}</a></th>
                <th><a href={`/cpu/${b!.slug}`}>{b!.name}</a></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Gaming score</td>
                <td class={a!.score >= b!.score ? 'win' : ''}>{a!.score}/100</td>
                <td class={b!.score >= a!.score ? 'win' : ''}>{b!.score}/100</td>
              </tr>
              <tr>
                <td>Tier</td>
                <td><span class={`pill t-${a!.tier}`}>{a!.tier}</span></td>
                <td><span class={`pill t-${b!.tier}`}>{b!.tier}</span></td>
              </tr>
              <tr>
                <td>Manufacturer</td>
                <td>{a!.brand}</td>
                <td>{b!.brand}</td>
              </tr>
              <tr>
                <td>Cores</td>
                <td class={a!.cores >= b!.cores ? 'win' : ''}>{a!.cores}</td>
                <td class={b!.cores >= a!.cores ? 'win' : ''}>{b!.cores}</td>
              </tr>
              <tr>
                <td>Threads</td>
                <td class={a!.threads >= b!.threads ? 'win' : ''}>{a!.threads}</td>
                <td class={b!.threads >= a!.threads ? 'win' : ''}>{b!.threads}</td>
              </tr>
              <tr>
                <td>Base clock</td>
                <td class={a!.base_ghz >= b!.base_ghz ? 'win' : ''}>{a!.base_ghz} GHz</td>
                <td class={b!.base_ghz >= a!.base_ghz ? 'win' : ''}>{b!.base_ghz} GHz</td>
              </tr>
              <tr>
                <td>Boost clock</td>
                <td class={a!.boost_ghz >= b!.boost_ghz ? 'win' : ''}>{a!.boost_ghz} GHz</td>
                <td class={b!.boost_ghz >= a!.boost_ghz ? 'win' : ''}>{b!.boost_ghz} GHz</td>
              </tr>
              <tr>
                <td>Power draw (TDP)</td>
                <td class={a!.tdp_watts <= b!.tdp_watts ? 'win' : ''}>{a!.tdp_watts} W</td>
                <td class={b!.tdp_watts <= a!.tdp_watts ? 'win' : ''}>{b!.tdp_watts} W</td>
              </tr>
              <tr>
                <td>Release year</td>
                <td class={a!.release_year >= b!.release_year ? 'win' : ''}>{a!.release_year}</td>
                <td class={b!.release_year >= a!.release_year ? 'win' : ''}>{b!.release_year}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <section class="takeaway">
          <h2>Which should you buy?</h2>
          <p>
            {winner
              ? <>For gaming specifically, the <b>{winner.name}</b> is the better buy — it holds a
                  {' '}{pct}% lead in our index, which shows up most at 1080p and in CPU-bound
                  titles like strategy and simulation games. </>
              : <>Gaming performance is a tie between these two, so the decision comes down to the
                  factors below. </>}
            {a!.cores !== b!.cores && (
              <>The <b>{a!.cores > b!.cores ? a!.name : b!.name}</b> has more cores
              ({Math.max(a!.cores, b!.cores)} vs {Math.min(a!.cores, b!.cores)}), which helps if you
              stream, compile or render alongside playing. </>
            )}
            {a!.tdp_watts !== b!.tdp_watts && (
              <>The <b>{a!.tdp_watts < b!.tdp_watts ? a!.name : b!.name}</b> runs
              {' '}{Math.abs(a!.tdp_watts - b!.tdp_watts)}W cooler, meaning a cheaper cooler and
              less case heat. </>
            )}
            Either way, pair it with a graphics card of similar standing — check the
            {' '}<a href="/bottleneck">bottleneck calculator</a> before you buy.
          </p>
          <div class="cta-row">
            <a href="/bottleneck" class="btn btn-ghost">Check for a bottleneck</a>
            <a href="/game-list/cpu-intensive-games" class="btn btn-ghost">CPU-heavy games</a>
          </div>
        </section>
      </>
    )}

    {!paired && (
      <section class="suggested">
        <h2>Popular comparisons</h2>
        <ul class="sug-list">
          {suggested.map(([x, y]) => (
            <li><a href={`/compare-cpu?a=${x.slug}&b=${y.slug}`}>{x.name} vs {y.name}</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="related">
      <h2>Related</h2>
      <ul>
        <li><a href="/cpus">CPU Database</a></li>
        <li><a href="/cpu-tier-list">CPU Tier List</a></li>
        <li><a href="/compare-gpu">Compare GPUs</a></li>
        <li><a href="/bottleneck">Bottleneck Calculator</a></li>
        <li><a href="/build-suggest">Build Suggester</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .picker {
    display: grid; grid-template-columns: 1fr auto 1fr auto; gap: 14px; align-items: end;
    background: var(--surface); border: 1px solid var(--line-strong);
    border-radius: 16px; padding: 20px; margin-bottom: 28px;
  }
  .picker label { display: block; }
  .picker label span { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .05em; }
  .picker select {
    width: 100%; background: var(--bg-soft); border: 1px solid var(--line-strong);
    border-radius: 10px; padding: 11px 12px; color: var(--text); font: inherit; outline: none;
  }
  .picker select:focus { border-color: var(--accent); }
  .vs { font-family: 'Space Grotesk', sans-serif; font-weight: 700; color: var(--faint); padding-bottom: 11px; }
  @media (max-width: 780px) { .picker { grid-template-columns: 1fr; } .vs { text-align: center; padding: 0; } }

  .verdict-banner {
    background: rgba(182,255,0,.08); border: 1px solid var(--line-strong);
    border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; font-size: 15px;
  }
  .verdict-banner :global(.icon) { color: var(--accent); margin-right: 6px; }

  .cmp th:not(:first-child), .cmp td:not(:first-child) { text-align: center; }
  .cmp td:first-child { color: var(--muted); }
  .cmp .win { color: var(--accent); font-weight: 700; }

  .takeaway { margin-top: 44px; }
  .takeaway h2 { font-size: 22px; margin-bottom: 14px; }
  .takeaway p { color: var(--muted); line-height: 1.8; max-width: 78ch; }
  .takeaway b { color: var(--text); }
  .takeaway a { color: var(--accent); }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }

  .suggested { margin-top: 40px; }
  .suggested h2 { font-size: 22px; margin-bottom: 16px; }
  .sug-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 10px; }
  .sug-list a {
    display: block; padding: 13px 16px; border: 1px solid var(--line); border-radius: 10px;
    color: var(--text); text-decoration: none; font-size: 14px; transition: border-color .2s var(--ease);
  }
  .sug-list a:hover { border-color: var(--accent); color: var(--accent); }
</style>
