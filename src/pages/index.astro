    color: #a0aabf;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .autocomplete-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--surface);
    border: 1px solid rgba(255,255,255,0.1);
