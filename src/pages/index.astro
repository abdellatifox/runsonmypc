    margin-bottom: 1rem;
    color: #a0aabf;
  }
  .tool.feat {
    grid-column: span 2;
    grid-row: span 2;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(135deg, var(--surface-2), var(--surface));
