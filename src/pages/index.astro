  .tool.feat :global(.icon) {
    font-size: 3rem;
    color: var(--accent);
  }
  .tool.wide {
    grid-column: span 2;
  }
  .games-grid, .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .game-card, .blog-card {
    background: var(--surface-2);
    border-radius: 12px;
    overflow: hidden;
    transition: 0.3s;
    border: 1px solid transparent;
  }
