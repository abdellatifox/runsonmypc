  }
  .ac-item {
    padding: 0.5rem;
    cursor: pointer;
  }
  .ac-item:hover {
    background: rgba(255,255,255,0.1);
  }
  .verdict-box {
    margin-top: 1rem;
    padding: 1rem;
    background: rgba(182, 255, 0, 0.1);
    border: 1px solid var(--accent);
    border-radius: 8px;
    text-align: center;
  }

  /* ====================================================================
     RESPONSIVE — must live inside this same <style> block.

     These rules were first added as a second <style> block appended to the
     file. Astro emitted that block BEFORE the original one, so the base
