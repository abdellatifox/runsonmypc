---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getGpus, getCpus } from '../lib/db';
import { SITE_URL } from '../lib/site';

const [gpus, cpus] = await Promise.all([getGpus(Astro.locals), getCpus(Astro.locals)]);

const description = 'Find the single upgrade that buys you the most frames per dollar. Enter your GPU, CPU and RAM to see what to replace first.';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "PC Upgrade Advisor",
    "url": `${SITE_URL}/upgrade-advisor`,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any (web browser)",
    "description": description,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Should I upgrade my GPU or my CPU first?",
        "acceptedAnswer": { "@type": "Answer", "text": "Upgrade whichever part is furthest behind the other. If your graphics card scores well below your processor, the GPU is capping your frame rate and should go first. If the processor is the weaker part, a faster GPU will sit idle in CPU-bound games and deliver much less than its benchmarks suggest." }
      },
      {
        "@type": "Question",
        "name": "How much RAM do I need for gaming in 2026?",
        "acceptedAnswer": { "@type": "Answer", "text": "16GB is the practical floor for new releases and 32GB is the comfortable target, especially if you keep a browser and chat apps open while playing. 8GB now forces texture pop-in and stutter in most 2024-onward titles." }
      },
      {
        "@type": "Question",
        "name": "Is it worth upgrading just the RAM?",
        "acceptedAnswer": { "@type": "Answer", "text": "It is the cheapest meaningful upgrade if you are on 8GB or running a single stick. Going from 8GB to 16GB, or from single-channel to dual-channel, removes stutter rather than raising peak frame rate — but stutter is usually what people actually notice." }
      }
    ]
  }
];
---
<BaseLayout
  title="PC Upgrade Advisor — What Should I Upgrade First? | PCGameFit"
  description={description}
  keywords="pc upgrade advisor, should i upgrade gpu or cpu, pc upgrade calculator, what to upgrade first gaming pc"
  jsonLd={schema}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Tools', href: '/tools' }, { name: 'Upgrade Advisor' }]} />

    <header class="page-head">
      <h1>What Should I Upgrade First?</h1>
      <p class="lede">
        Tell us what you have now. We compare your graphics card, processor and memory against
        each other and against current games, then point at the one change that gets you the
        most extra performance for the money.
      </p>
    </header>

    <div class="tool-panel">
      <div class="fields">
        <label>
          <span>Graphics card</span>
          <select id="gpu">
            {gpus.map(g => <option value={`${g.score}|${g.vram_gb}|${g.name}`}>{g.name}</option>)}
          </select>
        </label>
        <label>
          <span>Processor</span>
          <select id="cpu">
            {cpus.map(c => <option value={`${c.score}|${c.cores}|${c.name}`}>{c.name}</option>)}
          </select>
        </label>
        <label>
          <span>System memory</span>
          <select id="ram">
            <option value="4">4 GB</option>
            <option value="8">8 GB</option>
            <option value="16" selected>16 GB</option>
            <option value="32">32 GB</option>
            <option value="64">64 GB</option>
          </select>
        </label>
        <label>
          <span>Storage type</span>
          <select id="storage">
            <option value="nvme" selected>NVMe SSD</option>
            <option value="sata">SATA SSD</option>
            <option value="hdd">Hard drive</option>
          </select>
        </label>
        <label>
          <span>Target resolution</span>
          <select id="res">
            <option value="1080p" selected>1080p</option>
            <option value="1440p">1440p</option>
            <option value="4k">4K</option>
          </select>
        </label>
        <label>
          <span>Budget</span>
          <select id="budget">
            <option value="150">Up to $150</option>
            <option value="300" selected>Up to $300</option>
            <option value="600">Up to $600</option>
            <option value="1200">$600+</option>
          </select>
        </label>
      </div>
      <button id="advise" class="btn btn-primary full">Get my upgrade plan</button>
    </div>

    <div id="result" class="result" hidden>
      <div class="verdict-head">
        <span class="eyebrow">Priority upgrade</span>
        <h2 id="v-title"></h2>
        <p id="v-why"></p>
      </div>
      <div class="balance">
        <div class="bar-row">
          <span>GPU</span>
          <div class="track"><div class="fill gpu" id="bar-gpu"></div></div>
          <b id="val-gpu"></b>
        </div>
        <div class="bar-row">
          <span>CPU</span>
          <div class="track"><div class="fill cpu" id="bar-cpu"></div></div>
          <b id="val-cpu"></b>
        </div>
        <div class="bar-row">
          <span>RAM</span>
          <div class="track"><div class="fill ram" id="bar-ram"></div></div>
          <b id="val-ram"></b>
        </div>
      </div>
      <ol id="steps" class="steps"></ol>
      <div class="cta-row">
        <a href="/bottleneck" class="btn btn-ghost">Run a bottleneck check</a>
        <a href="/psu-calculator" class="btn btn-ghost">Check my PSU headroom</a>
      </div>
    </div>

    <section class="faq">
      <h2>Frequently asked questions</h2>
      <details>
        <summary>Should I upgrade my GPU or my CPU first?</summary>
        <p>Upgrade whichever part is furthest behind the other. If your graphics card scores well below your processor, the GPU is capping your frame rate and should go first. If the processor is the weaker part, a faster GPU will sit idle in CPU-bound games and deliver far less than its benchmarks suggest.</p>
      </details>
      <details>
        <summary>How much RAM do I need for gaming in 2026?</summary>
        <p>16GB is the practical floor for new releases and 32GB is the comfortable target if you keep a browser and chat apps open while playing. 8GB now causes texture pop-in and stutter in most 2024-onward titles.</p>
      </details>
      <details>
        <summary>Is it worth upgrading just the RAM?</summary>
        <p>It is the cheapest meaningful upgrade if you are on 8GB or running a single stick. Moving to 16GB, or from single- to dual-channel, removes stutter rather than raising peak frame rate — and stutter is usually what people actually notice.</p>
      </details>
      <details>
        <summary>Does a faster SSD increase FPS?</summary>
        <p>Not directly. Storage affects load times and streaming-in of world assets, so moving off a hard drive removes traversal stutter in open-world games, but it will not raise your average frame rate.</p>
      </details>
    </section>

    <section class="related">
      <h2>Related</h2>
      <ul>
        <li><a href="/bottleneck">Bottleneck Calculator</a></li>
        <li><a href="/build-suggest">Build Suggester</a></li>
        <li><a href="/compare-gpu">Compare GPUs</a></li>
        <li><a href="/gpu-tier-list">GPU Tier List</a></li>
        <li><a href="/pc-value">PC Value Calculator</a></li>
        <li><a href="/psu-calculator">PSU Calculator</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .tool-panel {
    background: var(--surface); border: 1px solid var(--line-strong);
    border-radius: 18px; padding: 26px; margin-bottom: 30px;
  }
  .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 20px; }
  .fields label { display: block; }
  .fields span { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .05em; }
  .fields select {
    width: 100%; background: var(--bg-soft); border: 1px solid var(--line-strong);
    border-radius: 10px; padding: 11px 12px; color: var(--text); font: inherit; outline: none;
  }
  .fields select:focus { border-color: var(--accent); }
  .btn.full { width: 100%; }

  .result {
    background: var(--surface); border: 1px solid var(--accent);
    border-radius: 18px; padding: 28px; margin-bottom: 40px;
  }
  .verdict-head h2 { font-size: 26px; margin: 8px 0 10px; }
  .verdict-head p { color: var(--muted); line-height: 1.7; margin: 0 0 24px; max-width: 70ch; }

  .balance { margin-bottom: 26px; }
  .bar-row { display: grid; grid-template-columns: 46px 1fr 54px; align-items: center; gap: 12px; margin-bottom: 10px; }
  .bar-row span { font-size: 12px; color: var(--muted); }
  .bar-row b { font-size: 13px; text-align: right; font-variant-numeric: tabular-nums; }
  .track { height: 8px; background: var(--surface-2); border-radius: 99px; overflow: hidden; }
  .fill { height: 100%; border-radius: 99px; transition: width .5s var(--ease); }
  .fill.gpu { background: var(--accent); }
  .fill.cpu { background: #8ab8ff; }
  .fill.ram { background: #ffc850; }

  .steps { margin: 0 0 24px; padding-left: 20px; }
  .steps li { color: var(--muted); line-height: 1.7; margin-bottom: 10px; }
  .steps li b { color: var(--text); }
  .steps li a { color: var(--accent); }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
</style>

<script>
  const $ = (id: string) => document.getElementById(id)!;

  $('advise').addEventListener('click', () => {
    const [gScoreS, gVramS, gName] = ($('gpu') as HTMLSelectElement).value.split('|');
    const [cScoreS, cCoresS, cName] = ($('cpu') as HTMLSelectElement).value.split('|');
    const gpuScore = +gScoreS, vram = +gVramS;
    const cpuScore = +cScoreS, cores = +cCoresS;
    const ram = +($('ram') as HTMLSelectElement).value;
    const storage = ($('storage') as HTMLSelectElement).value;
    const res = ($('res') as HTMLSelectElement).value;
    const budget = +($('budget') as HTMLSelectElement).value;

    // Normalise each subsystem onto a 0-100 "readiness" scale for the target res.
    const resNeed = res === '4k' ? 85 : res === '1440p' ? 65 : 45;
    const gpuHealth = Math.min(100, Math.round((gpuScore / resNeed) * 100));
    const cpuHealth = Math.min(100, Math.round((cpuScore / (resNeed * 0.85)) * 100));
    const ramHealth = Math.min(100, Math.round((ram / 16) * 100));

    ($('bar-gpu') as HTMLElement).style.width = gpuHealth + '%';
    ($('bar-cpu') as HTMLElement).style.width = cpuHealth + '%';
    ($('bar-ram') as HTMLElement).style.width = ramHealth + '%';
    $('val-gpu').textContent = gpuHealth + '%';
    $('val-cpu').textContent = cpuHealth + '%';
    $('val-ram').textContent = ramHealth + '%';

    const weakest = Math.min(gpuHealth, cpuHealth, ramHealth);
    let title = '', why = '';
    const steps: string[] = [];

    if (ram < 16) {
      title = 'Add system memory first';
      why = `At ${ram}GB you are below what current releases assume. Memory is the cheapest fix here and it removes stutter rather than just raising the average frame rate.`;
      steps.push(`Move to <b>16GB</b> (or 32GB if the budget allows) in <b>dual channel</b> — two matched sticks, not one.`);
    } else if (gpuHealth <= cpuHealth) {
      title = 'Upgrade the graphics card';
      why = `Your ${gName} is the limiting part at ${res}. The ${cName} has headroom to feed something faster, so a GPU upgrade converts almost directly into frames.`;
      steps.push(`Target a card scoring roughly <b>${Math.min(100, Math.round(cpuScore * 1.1))}</b> or better so it stays matched to your CPU — browse the <a href="/gpu-tier-list">GPU tier list</a>.`);
      if (vram < (res === '4k' ? 12 : 8)) {
        steps.push(`Your current <b>${vram}GB of VRAM</b> is tight for ${res}. Treat ${res === '4k' ? '16GB' : '12GB'} as the minimum on the replacement.`);
      }
    } else {
      title = 'Upgrade the processor';
      why = `Your ${cName} is holding back the ${gName}, especially at ${res} where the CPU sets the ceiling. A faster GPU right now would sit partly idle.`;
      steps.push(`Target a processor scoring around <b>${Math.min(100, Math.round(gpuScore * 1.05))}</b> — see the <a href="/cpu-tier-list">CPU tier list</a>.`);
      if (cores < 6) steps.push(`At <b>${cores} cores</b> you are under the 6-core baseline most 2024-onward titles assume. Prioritise core count.`);
      steps.push('Check whether your motherboard supports the new chip — a CPU upgrade often drags the board and memory with it.');
    }

    if (storage === 'hdd') {
      steps.push('Move your games to an <b>SSD</b>. It will not raise FPS, but it removes traversal stutter and long load screens in open-world games.');
    }
    if (ram >= 16 && ram < 32 && res !== '1080p') {
      steps.push('Consider <b>32GB</b> as a later step if you keep a browser, Discord and a stream open while playing.');
    }
    steps.push(`With a <b>$${budget}</b> budget, spend it on the single item above rather than splitting it — one meaningful jump beats two small ones.`);
    steps.push('Re-run the <a href="/bottleneck">bottleneck calculator</a> with the part you plan to buy before ordering.');

    $('v-title').textContent = title;
    $('v-why').textContent = why;
    $('steps').innerHTML = steps.map(s => `<li>${s}</li>`).join('');
    ($('result') as HTMLElement).hidden = false;
    $('result').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
