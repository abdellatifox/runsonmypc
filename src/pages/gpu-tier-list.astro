---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getGpus } from '../lib/db';
import Icon from '../components/Icon.astro';
import { SITE_URL } from '../lib/site';

/* Previously this page carried its own hardcoded copy of the GPU table, which
   had drifted out of sync with the database — the RTX 4070 was listed at 71
   here and 67 on its own page. One source of truth now. */
const gpus = await getGpus(Astro.locals);

const TIER_ORDER = ['S', 'A', 'B', 'C', 'D', 'F'];
const TIER_BLURB: Record<string, string> = {
  S: 'Flagship class. Comfortable at 4K with ray tracing enabled, and future-proof for several years.',
  A: 'High end. Excellent at 1440p high refresh, and capable at 4K with upscaling.',
  B: 'Upper mid-range. The 1440p sweet spot and very strong at 1080p.',
  C: 'Mid-range. Solid 1080p performance at high settings; 1440p with compromises.',
  D: 'Entry level. Playable 1080p at medium settings in most current titles.',
  F: 'Legacy. Below the bar for current releases — fine for older and esports titles.'
};

const tiers = TIER_ORDER
  .map(t => ({ tier: t, cards: gpus.filter(g => g.tier === t) }))
  .filter(t => t.cards.length > 0);

const year = new Date().getFullYear();
const best = gpus[0];
const bestValue = [...gpus]
  .filter(g => g.msrp_usd && g.score >= 45)
  .sort((a, b) => (b.score / b.msrp_usd!) - (a.score / a.msrp_usd!))[0];
const bestBudget = [...gpus]
  .filter(g => g.msrp_usd && g.msrp_usd <= 350)
  .sort((a, b) => b.score - a.score)[0];

const description = `Every graphics card ranked S through F for ${year} gaming. ${gpus.length} GPUs scored on real performance, with VRAM, power draw, MSRP and upscaling support for each.`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `GPU Tier List ${year}`,
    "description": description,
    "url": `${SITE_URL}/gpu-tier-list`,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": gpus.length,
      "itemListOrder": "https://schema.org/ItemListOrderDescending",
      "itemListElement": gpus.slice(0, 40).map((g, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `${SITE_URL}/gpu/${g.slug}`,
        "name": g.name
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `What is the best graphics card in ${year}?`,
        "acceptedAnswer": { "@type": "Answer", "text": `The ${best.name} tops our ranking with a score of ${best.score}/100 and ${best.vram_gb}GB of VRAM. It is the fastest consumer card we track and anchors the top of the scale.` }
      },
      {
        "@type": "Question",
        "name": "What do the tiers mean?",
        "acceptedAnswer": { "@type": "Answer", "text": "S tier is flagship class, comfortable at 4K with ray tracing. A tier is high end, excellent at 1440p. B tier is the 1440p sweet spot. C tier is solid 1080p. D tier is entry level 1080p at medium. F tier is legacy hardware below the bar for current releases." }
      },
      {
        "@type": "Question",
        "name": "Which graphics card offers the best value?",
        "acceptedAnswer": { "@type": "Answer", "text": bestValue ? `On launch pricing the ${bestValue.name} gives the most performance per dollar, scoring ${bestValue.score}/100 at an MSRP of $${bestValue.msrp_usd}.` : 'Value depends heavily on current street pricing rather than MSRP.' }
      },
      {
        "@type": "Question",
        "name": "How much VRAM do I need in " + year + "?",
        "acceptedAnswer": { "@type": "Answer", "text": "8GB is the practical minimum for 1080p, 12GB is the comfortable target for 1440p, and 16GB or more is what you want for 4K and heavily modded or texture-dense games." }
      }
    ]
  }
];
---
<BaseLayout
  title={`GPU Tier List ${year} — All ${gpus.length} Graphics Cards Ranked | PCGameFit`}
  description={description}
  keywords="gpu tier list, best graphics card, graphics card ranking, best gpu 2026, gpu hierarchy, graphics card tier list"
  jsonLd={schema}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Tools', href: '/tools' }, { name: 'GPU Tier List' }]} />

    <header class="page-head">
      <h1>GPU Tier List {year}</h1>
      <p class="lede">
        All {gpus.length} graphics cards we track, ranked S through F by real gaming
        performance. Scores are relative — the fastest consumer card anchors the top of the
        scale, so a card's number can move when a new flagship launches even though the card
        itself has not changed.
      </p>
    </header>

    <div class="picks">
      <div class="pick">
        <span>Fastest overall</span>
        <a href={`/gpu/${best.slug}`}>{best.name}</a>
        <em>{best.score}/100 · {best.vram_gb}GB</em>
      </div>
      {bestValue && (
        <div class="pick">
          <span>Best value</span>
          <a href={`/gpu/${bestValue.slug}`}>{bestValue.name}</a>
          <em>{bestValue.score}/100 · ${bestValue.msrp_usd}</em>
        </div>
      )}
      {bestBudget && (
        <div class="pick">
          <span>Best under $350</span>
          <a href={`/gpu/${bestBudget.slug}`}>{bestBudget.name}</a>
          <em>{bestBudget.score}/100 · ${bestBudget.msrp_usd}</em>
        </div>
      )}
    </div>

    {tiers.map(({ tier, cards }) => (
      <section class="tier-block">
        <div class="tier-head">
          <div class={`tier-badge t-${tier}`}>{tier}</div>
          <div>
            <h2>Tier {tier}</h2>
            <p>{TIER_BLURB[tier]}</p>
          </div>
        </div>
        <div class="card-rail">
          {cards.map(g => (
            <a href={`/gpu/${g.slug}`} class="gpu-chip">
              <b>{g.name}</b>
              <span class="chip-meta">{g.score} · {g.vram_gb}GB · {g.tdp_watts}W</span>
              <span class="chip-feats">
                {g.supports_ray_tracing ? <Icon name="lightbulb-fill" title="Ray tracing" label="Ray tracing" /> : null}
                {g.supports_dlss ? <em>DLSS</em> : null}
                {g.supports_fsr ? <em>FSR</em> : null}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="full-table">
      <h2>Full ranking</h2>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr><th>#</th><th>Graphics card</th><th>Tier</th><th>Score</th><th>VRAM</th><th>TDP</th><th>MSRP</th><th>Year</th></tr>
          </thead>
          <tbody>
            {gpus.map((g, i) => (
              <tr>
                <td class="rank">{i + 1}</td>
                <td><a href={`/gpu/${g.slug}`}>{g.name}</a></td>
                <td><span class={`pill t-${g.tier}`}>{g.tier}</span></td>
                <td><b>{g.score}</b></td>
                <td>{g.vram_gb} GB</td>
                <td>{g.tdp_watts} W</td>
                <td>{g.msrp_usd ? `$${g.msrp_usd}` : '—'}</td>
                <td>{g.release_year}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="faq">
      <h2>Frequently asked questions</h2>
      <details>
        <summary>What is the best graphics card in {year}?</summary>
        <p>The <a href={`/gpu/${best.slug}`}>{best.name}</a> tops our ranking at {best.score}/100 with {best.vram_gb}GB of VRAM. It is the fastest consumer card we track and anchors the top of the scale.</p>
      </details>
      <details>
        <summary>What do the tiers mean?</summary>
        <p>S is flagship class, comfortable at 4K with ray tracing. A is high end, excellent at 1440p. B is the 1440p sweet spot. C is solid 1080p. D is entry-level 1080p at medium. F is legacy hardware below the bar for current releases.</p>
      </details>
      <details>
        <summary>Which card offers the best value?</summary>
        <p>{bestValue
          ? <>On launch pricing the <a href={`/gpu/${bestValue.slug}`}>{bestValue.name}</a> gives the most performance per dollar — {bestValue.score}/100 at ${bestValue.msrp_usd}. Street prices move, so check current listings too.</>
          : <>Value depends heavily on current street pricing rather than MSRP.</>}</p>
      </details>
      <details>
        <summary>How much VRAM do I need?</summary>
        <p>8GB is the practical minimum for 1080p, 12GB is the comfortable target for 1440p, and 16GB or more is what you want for 4K and texture-dense games.</p>
      </details>
      <details>
        <summary>Why did a card's score change?</summary>
        <p>Scores are relative to the fastest card we track. When a new flagship launches, everything below it is recalibrated — the ruler got longer, the card did not get slower. See our <a href="/editorial-standards">editorial standards</a>.</p>
      </details>
    </section>

    <section class="related">
      <h2>Related</h2>
      <ul>
        <li><a href="/cpu-tier-list">CPU Tier List</a></li>
        <li><a href="/gpus">GPU Database</a></li>
        <li><a href="/compare-gpu">Compare GPUs</a></li>
        <li><a href="/benchmarks">Benchmarks</a></li>
        <li><a href="/bottleneck">Bottleneck Calculator</a></li>
        <li><a href="/upgrade-advisor">Upgrade Advisor</a></li>
        <li><a href="/psu-calculator">PSU Calculator</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .picks { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 44px; }
  .pick { border: 1px solid var(--line-strong); border-radius: 14px; padding: 18px 20px; background: var(--surface); }
  .pick span { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin-bottom: 8px; }
  .pick a { display: block; color: var(--accent); text-decoration: none; font-weight: 600; font-size: 16px; margin-bottom: 5px; }
  .pick a:hover { text-decoration: underline; }
  .pick em { font-style: normal; color: var(--faint); font-size: 12.5px; }

  .tier-block { margin-bottom: 40px; }
  .tier-head { display: flex; gap: 16px; align-items: flex-start; margin-bottom: 16px; }
  .tier-badge {
    width: 52px; height: 52px; flex: none; display: grid; place-items: center;
    border-radius: 12px; font-family: 'Space Grotesk', sans-serif; font-size: 24px;
    font-weight: 700; color: #000;
  }
  .tier-badge.t-S { background: #ff7f7f; } .tier-badge.t-A { background: #ffbf7f; }
  .tier-badge.t-B { background: #ffff7f; } .tier-badge.t-C { background: #7fff7f; }
  .tier-badge.t-D { background: #7fbfff; } .tier-badge.t-F { background: #bfbfbf; }
  .tier-head h2 { font-size: 19px; margin: 0 0 5px; }
  .tier-head p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.55; max-width: 70ch; }

  .card-rail { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 10px; }
  .gpu-chip {
    display: block; padding: 13px 15px; border: 1px solid var(--line); border-radius: 12px;
    background: var(--surface); text-decoration: none; color: var(--text);
    transition: border-color .2s var(--ease), transform .2s var(--ease);
  }
  .gpu-chip:hover { border-color: var(--accent); transform: translateY(-2px); }
  .gpu-chip b { display: block; font-size: 14px; margin-bottom: 5px; }
  .chip-meta { display: block; color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .chip-feats { display: flex; gap: 6px; align-items: center; margin-top: 7px; }
  .chip-feats :global(.icon) { color: #8ab8ff; font-size: 11px; }
  .chip-feats em {
    font-style: normal; font-size: 9.5px; font-weight: 700; letter-spacing: .04em;
    padding: 2px 6px; border-radius: 4px; background: rgba(182,255,0,.12); color: var(--accent);
  }

  .full-table { margin-top: 52px; }
  .full-table h2 { font-size: 22px; margin-bottom: 18px; }
  .rank { color: var(--faint); font-variant-numeric: tabular-nums; }
</style>
