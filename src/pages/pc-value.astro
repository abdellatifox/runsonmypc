---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getGpus, getCpus } from '../lib/db';
import { SITE_URL } from '../lib/site';

const [gpus, cpus] = await Promise.all([getGpus(Astro.locals), getCpus(Astro.locals)]);
const thisYear = new Date().getFullYear();

const description = 'Estimate what your gaming PC is worth second-hand. Enter your GPU, CPU, RAM and storage for a realistic private-sale price range.';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "PC Value Calculator",
    "url": `${SITE_URL}/pc-value`,
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Any (web browser)",
    "description": description,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much does a gaming PC lose in value each year?",
        "acceptedAnswer": { "@type": "Answer", "text": "Graphics cards hold value best but still lose roughly 18-25% per year, accelerating sharply when a new generation launches. Processors depreciate more slowly at around 15% per year, while memory and storage lose value mostly in line with falling new prices." }
      },
      {
        "@type": "Question",
        "name": "Is it better to sell a PC whole or in parts?",
        "acceptedAnswer": { "@type": "Answer", "text": "Selling parts individually typically nets 15-30% more than selling a complete system, because buyers are usually shopping for one specific upgrade. Selling whole is faster and far less effort, so the premium is really payment for your time." }
      },
      {
        "@type": "Question",
        "name": "When is the worst time to sell a graphics card?",
        "acceptedAnswer": { "@type": "Answer", "text": "Immediately after a new generation is announced. Prices on the outgoing generation drop fastest between the announcement and the first weeks of availability, so selling before an announcement is usually worth a noticeable amount." }
      }
    ]
  }
];
---
<BaseLayout
  title="PC Value Calculator — What Is My Gaming PC Worth? | PCGameFit"
  description={description}
  keywords="pc value calculator, pc valuation, what is my gaming pc worth, sell my gaming pc, used gpu value, pc resale value"
  jsonLd={schema}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Tools', href: '/tools' }, { name: 'PC Value Calculator' }]} />

    <header class="page-head">
      <h1>What Is My Gaming PC Worth?</h1>
      <p class="lede">
        A realistic private-sale estimate — a quick PC valuation — based on launch pricing, component age
        and how each class of part actually depreciates. Useful whether you are selling, buying used, or
        working out whether an upgrade is worth it.
      </p>
    </header>

    <div class="tool-panel">
      <div class="fields">
        <label>
          <span>Graphics card</span>
          <select id="gpu">
            {gpus.map(g => <option value={`${g.msrp_usd || 0}|${g.release_year}`}>{g.name}</option>)}
          </select>
        </label>
        <label>
          <span>Processor</span>
          <select id="cpu">
            {cpus.map(c => <option value={`${Math.round(c.score * 5.5)}|${c.release_year}`}>{c.name}</option>)}
          </select>
        </label>
        <label>
          <span>System memory</span>
          <select id="ram">
            <option value="30">8 GB</option>
            <option value="55" selected>16 GB</option>
            <option value="105">32 GB</option>
            <option value="200">64 GB</option>
          </select>
        </label>
        <label>
          <span>Storage</span>
          <select id="storage">
            <option value="35">500 GB SSD</option>
            <option value="60" selected>1 TB NVMe</option>
            <option value="105">2 TB NVMe</option>
            <option value="190">4 TB NVMe</option>
          </select>
        </label>
        <label>
          <span>Rest of system</span>
          <select id="rest">
            <option value="120">Budget case, board and PSU</option>
            <option value="220" selected>Mid-range case, board and PSU</option>
            <option value="400">Premium case, board and PSU</option>
          </select>
        </label>
        <label>
          <span>Condition</span>
          <select id="cond">
            <option value="1.0">Like new, boxed</option>
            <option value="0.9" selected>Good, working order</option>
            <option value="0.75">Heavy use or cosmetic damage</option>
          </select>
        </label>
      </div>
      <button id="calc" class="btn btn-primary full">Estimate my PC's value</button>
    </div>

    <div id="result" class="result" hidden>
      <div class="headline">
        <span class="eyebrow">Estimated private sale value</span>
        <div class="range"><span id="low"></span> <em>–</em> <span id="high"></span></div>
        <p class="sub">Selling as a complete system. Parting it out typically adds 15–30%.</p>
      </div>
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>Component</th><th>Estimated value</th><th>Share</th></tr></thead>
          <tbody id="breakdown"></tbody>
        </table>
      </div>
      <p class="disclaimer">
        Estimates model launch pricing against age-based depreciation. Real prices swing with
        local demand, generation launches and stock levels — always check recent completed
        listings in your own market before setting a price.
      </p>
    </div>

    <section class="faq">
      <h2>Frequently asked questions</h2>
      <details>
        <summary>How much value does a gaming PC lose each year?</summary>
        <p>Graphics cards hold value best but still lose roughly 18–25% a year, accelerating sharply when a new generation launches. Processors depreciate more slowly at around 15%, while memory and storage track falling new prices.</p>
      </details>
      <details>
        <summary>Is it better to sell whole or in parts?</summary>
        <p>Parting out typically nets 15–30% more, because buyers are usually shopping for one specific upgrade. Selling whole is far faster, so the premium is really payment for your time.</p>
      </details>
      <details>
        <summary>When is the worst time to sell a graphics card?</summary>
        <p>Right after a new generation is announced. Outgoing-generation prices fall fastest between the announcement and the first weeks of availability.</p>
      </details>
      <details>
        <summary>Should I sell or upgrade?</summary>
        <p>If one part is dragging the rest down, upgrading that single part is usually better value than replacing the system. Run the <a href="/upgrade-advisor">upgrade advisor</a> before deciding.</p>
      </details>
    </section>

    <section class="related">
      <h2>Related</h2>
      <ul>
        <li><a href="/upgrade-advisor">Upgrade Advisor</a></li>
        <li><a href="/build-suggest">Build Suggester</a></li>
        <li><a href="/compare-gpu">Compare GPUs</a></li>
        <li><a href="/gpus">GPU Database</a></li>
        <li><a href="/bottleneck">Bottleneck Calculator</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .tool-panel { background: var(--surface); border: 1px solid var(--line-strong); border-radius: 18px; padding: 26px; margin-bottom: 30px; }
  .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 20px; }
  .fields label { display: block; }
  .fields span { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .05em; }
  .fields select { width: 100%; background: var(--bg-soft); border: 1px solid var(--line-strong); border-radius: 10px; padding: 11px 12px; color: var(--text); font: inherit; outline: none; }
  .fields select:focus { border-color: var(--accent); }
  .btn.full { width: 100%; }

  .result { background: var(--surface); border: 1px solid var(--accent); border-radius: 18px; padding: 28px; margin-bottom: 44px; }
  .headline { text-align: center; margin-bottom: 26px; }
  .range { font-family: 'Space Grotesk', sans-serif; font-size: clamp(30px, 6vw, 46px); font-weight: 700; color: var(--accent); margin: 10px 0 8px; }
  .range em { font-style: normal; color: var(--faint); }
  .sub { color: var(--muted); font-size: 14px; margin: 0; }
  .disclaimer { color: var(--faint); font-size: 13px; line-height: 1.7; margin-top: 18px; }
  section { margin-bottom: 48px; }
  section h2 { font-size: 22px; margin-bottom: 18px; }
</style>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const YEAR = new Date().getFullYear();
  const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');

  /** Depreciation curve: steep in year one, flattening afterwards. */
  function depreciate(msrp: number, year: number, annual: number) {
    const age = Math.max(0, YEAR - year);
    return msrp * Math.pow(1 - annual, age) * (age === 0 ? 0.85 : 1);
  }

  $('calc').addEventListener('click', () => {
    const [gMsrpS, gYearS] = ($('gpu') as HTMLSelectElement).value.split('|');
    const [cMsrpS, cYearS] = ($('cpu') as HTMLSelectElement).value.split('|');
    const ram = +($('ram') as HTMLSelectElement).value;
    const storage = +($('storage') as HTMLSelectElement).value;
    const rest = +($('rest') as HTMLSelectElement).value;
    const cond = +($('cond') as HTMLSelectElement).value;

    const gpuVal = depreciate(+gMsrpS, +gYearS, 0.22) * cond;
    const cpuVal = depreciate(+cMsrpS, +cYearS, 0.15) * cond;
    const ramVal = ram * 0.62 * cond;
    const stoVal = storage * 0.58 * cond;
    const restVal = rest * 0.45 * cond;

    const parts = [
      { name: 'Graphics card', v: gpuVal },
      { name: 'Processor', v: cpuVal },
      { name: 'Memory', v: ramVal },
      { name: 'Storage', v: stoVal },
      { name: 'Case, board & PSU', v: restVal }
    ];
    const total = parts.reduce((s, p) => s + p.v, 0);

    $('low').textContent = money(total * 0.85);
    $('high').textContent = money(total * 1.12);
    $('breakdown').innerHTML = parts
      .map(p => `<tr><td>${p.name}</td><td>${money(p.v)}</td><td>${total ? Math.round(p.v / total * 100) : 0}%</td></tr>`)
      .join('') + `<tr><td><b>Total</b></td><td><b>${money(total)}</b></td><td>100%</td></tr>`;

    ($('result') as HTMLElement).hidden = false;
    $('result').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
