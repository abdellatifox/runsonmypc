---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Autocomplete from '../components/Autocomplete.astro';
import Icon from '../components/Icon.astro';
import { bundledCount } from '../lib/game-reqs';
import { SITE_URL } from '../lib/site';

const bundled = bundledCount();

const RAM_OPTIONS = [4, 6, 8, 12, 16, 24, 32, 48, 64, 96, 128].map(n => ({
  label: `${n} GB`,
  value: String(n)
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "What Can My PC Run?",
    "url": `${SITE_URL}/what-can-my-pc-run`,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any (web browser)",
    "description": "Enter your PC specs once and see every game your machine handles, checked against the publisher's own stated requirements.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What games can my PC run?",
        "acceptedAnswer": { "@type": "Answer", "text": "Enter your graphics card, processor and RAM once and we check them against every game in our library with publisher-stated requirements, sorting the results into Ultra, High and Medium so you can see what you can play and at roughly what setting." }
      },
      {
        "@type": "Question",
        "name": "What will my PC run at Ultra settings?",
        "acceptedAnswer": { "@type": "Answer", "text": "A game lands in Ultra when your graphics card clears the recommended requirement with real headroom to spare — not just barely meets it. High means you meet the recommended spec; Medium means you clear the minimum but not the recommended tier." }
      },
      {
        "@type": "Question",
        "name": "Why is a game missing from the list?",
        "acceptedAnswer": { "@type": "Answer", "text": "Either the publisher never listed PC requirements for it, or the listed requirements name no dimension we can compare against your parts — we would rather leave a title out than guess." }
      }
    ]
  }
];
---
<BaseLayout
  title="What Can My PC Run? — Find Compatible Games | PCGameFit"
  description="What will my PC run? Enter your specs once and see every game your machine handles, and at which settings — Ultra, High or Medium — checked against real published requirements."
  keywords="what can my pc run, what will my pc run, what games can my pc run, compatible games for my pc, pc game compatibility"
  jsonLd={schema}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Tools', href: '/tools' }, { name: 'What Can My PC Run' }]} />

    <header class="page-head">
      <h1>What Can My PC Run?</h1>
      <p class="lede">
        Enter your GPU, CPU and RAM once to see what games your PC can run — checked against
        {bundled > 0 ? `${bundled.toLocaleString('en-US')} titles with` : 'every title with'} publisher-stated
        requirements, and sorted by the settings you can expect.
      </p>
    </header>

    <section class="tool">
      <form class="panel" id="scan-form" novalidate>
        <Autocomplete
          id="gpu"
          label="Graphics card"
          placeholder="e.g. RTX 4070, RX 6600, Arc B580…"
          endpoint="/api/gpus/search"
          required
        />
        <Autocomplete
          id="cpu"
          label="Processor"
          placeholder="e.g. Ryzen 5 5600, i5-12400…"
          endpoint="/api/cpus/search"
          hint="Optional, but it rules out a few CPU-bound titles."
        />
        <Autocomplete
          id="ram"
          label="System memory"
          placeholder="e.g. 16 GB"
          endpoint=""
          options={RAM_OPTIONS}
          freeText
          required
        />
        <button type="submit" class="btn btn-primary submit" id="scan-btn">
          Find compatible games <span aria-hidden="true">&rarr;</span>
        </button>
        <p class="err" id="form-err" role="alert" hidden></p>
      </form>

      <div class="results" id="results" aria-live="polite">
        <div class="placeholder" id="placeholder">
          <Icon name="joystick" />
          <h2>Enter your specs to see results</h2>
          <p>{bundled > 0
            ? `Checked against ${bundled.toLocaleString('en-US')} games with real, publisher-stated requirements.`
            : 'Checked against publisher-stated requirements.'}</p>
        </div>
      </div>
    </section>

    <section class="faq">
      <h2>Frequently asked questions</h2>
      <details>
        <summary>What games can my PC run?</summary>
        <p>Enter your graphics card, processor and RAM once and we check them against every game in our library with publisher-stated requirements, sorting the results into Ultra, High and Medium.</p>
      </details>
      <details>
        <summary>What will my PC run at Ultra settings?</summary>
        <p>A game lands in Ultra when your graphics card clears the recommended requirement with real headroom to spare — not just barely meets it. High means you meet the recommended spec; Medium means you clear the minimum but not the recommended tier.</p>
      </details>
      <details>
        <summary>Why is a game missing from the list?</summary>
        <p>Either the publisher never listed PC requirements for it, or the listed requirements name no dimension we can compare against your parts — we would rather leave a title out than guess.</p>
      </details>
    </section>

    <section class="related">
      <h2>Related</h2>
      <ul>
        <li><a href="/can-it-run">Can I Run It?</a></li>
        <li><a href="/fps-estimator">FPS Calculator</a></li>
        <li><a href="/gpu-tier-list">GPU Tier List</a></li>
        <li><a href="/games">All games</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .tool {
    display: grid;
    grid-template-columns: minmax(300px, 380px) 1fr;
    gap: 24px;
    align-items: start;
    margin-bottom: 56px;
  }
  @media (max-width: 900px) { .tool { grid-template-columns: 1fr; } }

  .panel {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    padding: 22px;
    display: grid;
    gap: 16px;
  }
  .submit { width: 100%; margin-top: 4px; }
  .err { color: #ff8080; font-size: 13.5px; margin: 0; }

  .results { min-height: 320px; }
  .placeholder {
    height: 100%;
    min-height: 320px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 40px 24px;
  }
  .placeholder :global(.icon) { font-size: 40px; color: var(--faint); }
  .placeholder h2 { font-size: 18px; margin: 0; }
  .placeholder p { margin: 0; color: var(--muted); font-size: 14px; max-width: 42ch; }

  :global(.scan-summary) {
    background: var(--surface); border: 1px solid var(--accent);
    border-radius: 18px; padding: 20px 24px; margin-bottom: 20px; font-size: 15px; color: var(--text);
  }
  :global(.scan-summary b) { color: var(--accent); }
  :global(.tier-tabs) { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  :global(.tier-tab) {
    background: transparent; border: 1px solid var(--line-strong); color: var(--muted);
    padding: 7px 15px; border-radius: 999px; font: inherit; font-size: 13px; cursor: pointer;
  }
  :global(.tier-tab.active) { background: var(--accent); border-color: var(--accent); color: #000; font-weight: 600; }
  :global(.games-grid) { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
  :global(.game-card) {
    display: block; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px;
    background: var(--surface); text-decoration: none; color: var(--text);
    transition: border-color .2s var(--ease);
  }
  :global(.game-card:hover) { border-color: var(--accent); }
  :global(.game-card b) { display: block; font-size: 13.5px; margin-bottom: 3px; }
  :global(.game-card span) { display: block; font-size: 12px; color: var(--muted); }
  :global(.tier-empty) { color: var(--muted); font-size: 14px; padding: 20px 0; }
</style>

<script>
  const form = document.getElementById('scan-form') as HTMLFormElement;
  const results = document.getElementById('results')!;
  const errEl = document.getElementById('form-err') as HTMLElement;
  const btn = document.getElementById('scan-btn') as HTMLButtonElement;

  const val = (id: string) =>
    (document.getElementById(`${id}-value`) as HTMLInputElement | null)?.value?.trim() || '';

  function esc(s: unknown) {
    return String(s ?? '').replace(/[&<>"']/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }

  const TIER_LABEL: Record<string, string> = { ultra: 'Ultra', high: 'High', medium: 'Medium' };

  function cardsFor(list: any[]) {
    if (!list.length) return '<p class="tier-empty">No titles in this tier for your current specs.</p>';
    return `<div class="games-grid">${list.map(g => `
      <a class="game-card" href="/can-it-run?game=${esc(g.slug)}">
        <b>${esc(g.name)}</b>
        ${g.year ? `<span>${esc(g.year)}</span>` : ''}
      </a>`).join('')}</div>`;
  }

  function render(d: any) {
    const total = d.counts.ultra + d.counts.high + d.counts.medium;
    const summary = total
      ? `Running <b>${d.counts.ultra}</b> games at Ultra, <b>${d.counts.high}</b> at High, <b>${d.counts.medium}</b> at Medium` +
        (d.counts.below ? ` — ${d.counts.below} more fall below your ${esc(d.you.gpu.name)}.` : '.')
      : `None of our checked titles clear the minimum for a ${esc(d.you.gpu.name)} with ${d.you.ramGb}GB RAM yet.`;

    results.innerHTML = `
      <div class="scan-summary">${summary}</div>
      <div class="tier-tabs" role="group" aria-label="Settings tier">
        <button type="button" class="tier-tab active" data-tier="ultra">Ultra (${d.counts.ultra})</button>
        <button type="button" class="tier-tab" data-tier="high">High (${d.counts.high})</button>
        <button type="button" class="tier-tab" data-tier="medium">Medium (${d.counts.medium})</button>
      </div>
      <div id="tier-body">${cardsFor(d.games.ultra)}</div>`;

    const body = document.getElementById('tier-body')!;
    results.querySelectorAll<HTMLButtonElement>('.tier-tab').forEach(t => {
      t.addEventListener('click', () => {
        results.querySelectorAll('.tier-tab').forEach(x => x.classList.remove('active'));
        t.classList.add('active');
        body.innerHTML = cardsFor(d.games[t.dataset.tier as string] || []);
      });
    });
  }

  form.addEventListener('submit', async e => {
    e.preventDefault();
    errEl.hidden = true;

    const gpu = val('gpu');
    const cpu = val('cpu');
    const ram = parseInt(val('ram') || '0', 10);

    if (!gpu) { errEl.textContent = 'Pick your graphics card from the suggestions.'; errEl.hidden = false; return; }
    if (!ram) { errEl.textContent = 'Choose how much system memory you have.'; errEl.hidden = false; return; }

    btn.disabled = true;
    btn.textContent = 'Scanning…';
    try {
      const r = await fetch('/api/tools/what-can-my-pc-run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ gpu, cpu, ram })
      });
      const d = await r.json();
      if (!r.ok) {
        errEl.textContent = d.error || 'That scan could not be completed.';
        errEl.hidden = false;
      } else {
        render(d);
      }
    } catch {
      errEl.textContent = 'Network error — please try again.';
      errEl.hidden = false;
    } finally {
      btn.disabled = false;
      btn.innerHTML = 'Find compatible games <span aria-hidden="true">&rarr;</span>';
    }
  });
</script>
