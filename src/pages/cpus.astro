---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCpus } from '../lib/db';
import { SITE_URL } from '../lib/site';

const cpus = await getCpus(Astro.locals);
const brands = [...new Set(cpus.map(c => c.brand))].sort();

const description = `Complete database of ${cpus.length} gaming processors ranked by performance, with cores, threads, clock speeds, TDP and tier for every Intel and AMD chip we track.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "CPU Database",
  "description": description,
  "url": `${SITE_URL}/cpus`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": cpus.length,
    "itemListElement": cpus.slice(0, 40).map((c, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `${SITE_URL}/cpu/${c.slug}`,
      "name": c.name
    }))
  }
};
---
<BaseLayout
  title={`CPU Database — All ${cpus.length} Gaming Processors Ranked | PCGameFit`}
  description={description}
  keywords="cpu database, processor list, gaming cpu ranking, intel vs amd, cpu specs, cpu comparison"
  jsonLd={schema}
>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'CPU Database' }]} />

    <header class="page-head">
      <h1>CPU Database</h1>
      <p class="lede">
        Every gaming processor we track, ranked by performance score. Cores, clocks, power
        draw and tier — click through for the full breakdown and comparisons.
      </p>
    </header>

    <div class="controls">
      <input type="search" id="cpu-filter" placeholder="Filter by name…" aria-label="Filter processors">
      <div class="brand-chips" role="group" aria-label="Filter by brand">
        <button class="chip active" data-brand="">All</button>
        {brands.map(b => <button class="chip" data-brand={b}>{b}</button>)}
      </div>
    </div>

    <div class="table-scroll">
      <table class="data-table" id="cpu-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Processor</th>
            <th>Tier</th>
            <th>Score</th>
            <th>Cores</th>
            <th>Threads</th>
            <th>Base</th>
            <th>Boost</th>
            <th>TDP</th>
            <th>Year</th>
          </tr>
        </thead>
        <tbody>
          {cpus.map((c, i) => (
            <tr data-brand={c.brand} data-name={c.name.toLowerCase()}>
              <td class="rank">{i + 1}</td>
              <td><a href={`/cpu/${c.slug}`}>{c.name}</a></td>
              <td><span class={`pill t-${c.tier}`}>{c.tier}</span></td>
              <td><b>{c.score}</b></td>
              <td>{c.cores}</td>
              <td>{c.threads}</td>
              <td>{c.base_ghz} GHz</td>
              <td>{c.boost_ghz} GHz</td>
              <td>{c.tdp_watts} W</td>
              <td>{c.release_year}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <section class="related">
      <h2>Related</h2>
      <ul>
        <li><a href="/cpu-tier-list">CPU Tier List 2026</a></li>
        <li><a href="/compare-cpu">Compare two CPUs</a></li>
        <li><a href="/gpus">GPU Database</a></li>
        <li><a href="/bottleneck">Bottleneck Calculator</a></li>
        <li><a href="/game-list/cpu-intensive-games">CPU-intensive games</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .controls { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-bottom: 22px; }
  .controls input {
    flex: 1 1 240px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: 10px 14px;
    color: var(--text);
    font: inherit;
    outline: none;
  }
  .controls input:focus { border-color: var(--accent); }
  .brand-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip {
    background: transparent; border: 1px solid var(--line-strong); color: var(--muted);
    padding: 6px 14px; border-radius: 999px; font: inherit; font-size: 13px; cursor: pointer;
    transition: all .2s var(--ease);
  }
  .chip:hover { color: var(--text); }
  .chip.active { background: var(--accent); border-color: var(--accent); color: #000; font-weight: 600; }
  .rank { color: var(--faint); font-variant-numeric: tabular-nums; }
</style>

<script>
  const rows = document.querySelectorAll<HTMLTableRowElement>('#cpu-table tbody tr');
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const input = document.getElementById('cpu-filter') as HTMLInputElement;
  let brand = '', term = '';

  function apply() {
    rows.forEach(r => {
      const ok = (!brand || r.dataset.brand === brand)
              && (!term || (r.dataset.name || '').includes(term));
      r.hidden = !ok;
    });
  }
  chips.forEach(c => c.addEventListener('click', () => {
    chips.forEach(x => x.classList.remove('active'));
    c.classList.add('active');
    brand = c.dataset.brand || '';
    apply();
  }));
  input?.addEventListener('input', () => { term = input.value.trim().toLowerCase(); apply(); });
</script>
