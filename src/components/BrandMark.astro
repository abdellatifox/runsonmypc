---
/**
 * The RunsOnMyPC mark: a monitor whose bottom-right corner carries the same
 * chamfer as the primary buttons, with a "run" triangle on the screen.
 * Inline SVG, so it costs no request and never shows a broken image.
 */
interface Props {
  class?: string;
  /** Unique per page when the mark appears more than once (gradient ids). */
  id?: string;
}
const { class: className = '', id = 'bm' } = Astro.props;
---
<svg class={className} viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8E7DFF" />
      <stop offset="1" stop-color="#45C9FF" />
    </linearGradient>
  </defs>
  <path d="M4 5.5h24v13.5l-4 4H4z" fill="#0F1424" stroke={`url(#${id}-g)`} stroke-width="2.2" stroke-linejoin="miter" />
  <path d="M13 9.5l7.5 4.75L13 19z" fill="#45C9FF" />
  <path d="M11 27.5h10" stroke="#8E7DFF" stroke-width="2.2" stroke-linecap="square" />
</svg>
